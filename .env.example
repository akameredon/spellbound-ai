# Browser-safe configuration only. Copy to .env.local for local development.
# Vite exposes every VITE_* value in public browser assets. Never put private API
# keys, Supabase service-role keys, or payment secrets in VITE_* variables.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional public identifiers; not secret credentials.
VITE_ELEVENLABS_VOICE_ID_OWL=21m00Tcm4TlvDq8ikWAM
VITE_ELEVENLABS_VOICE_ID_WIZARD=AZnzlk1XvdvUeBnXmlld

# Only if a supported RevenueCat web integration is configured:
# VITE_REVENUECAT_PUBLIC_SDK_KEY=

# Server-side secrets belong in your server runtime / Supabase Edge Function secrets:
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Payment-provider secret keys and webhook signing secrets
